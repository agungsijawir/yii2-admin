{
    "name": "agungsijawir/yii2-admin",
    "description": "RBAC Auth manager for Yii2",
    "keywords": ["yii", "admin", "auth", "rbac"],
    "type": "yii2-extension",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Misbahul Munir",
            "email": "misbahuldmunir@gmail.com"
        },
        {
            "name": "Freddo Kresna",
            "email": "freddokresna@gmail.com"
        },
        {
            "name": "Agung Andika",
            "email": "agung@agungandika.com"
        }
    ],
    "require": {
        "php": ">=8.0.0",
        "yiisoft/yii2": "~2.0.14"
    },
    "autoload": {
        "psr-4": {
            "mdm\\admin\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    }
}
